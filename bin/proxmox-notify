#!/usr/bin/env bash
set -euo pipefail

_self_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [[ -n "${PROXMOX_NOTIFY_LIB_DIR:-}" ]]; then
  # shellcheck source=../lib/proxmox-notify/proxmox-notify.sh
  source "${PROXMOX_NOTIFY_LIB_DIR}/proxmox-notify.sh"
elif [[ -f "${_self_dir}/../lib/proxmox-notify/proxmox-notify.sh" ]]; then
  # shellcheck source=../lib/proxmox-notify/proxmox-notify.sh
  source "${_self_dir}/../lib/proxmox-notify/proxmox-notify.sh"
else
  # shellcheck source=/usr/local/lib/proxmox-notify/proxmox-notify.sh
  source "/usr/local/lib/proxmox-notify/proxmox-notify.sh"
fi

usage() {
  cat <<'USAGE'
Usage:
  proxmox-notify announce
  proxmox-notify publish --namespace <ns> --payload-file <path>
  proxmox-notify get --namespace <ns> [--node <nodename>]
  proxmox-notify list-manifests --namespace <ns>
  proxmox-notify list-nodes
  proxmox-notify delete --namespace <ns>
  proxmox-notify reconcile --namespace <ns>
  proxmox-notify subscribe --namespace <ns> --handler <path>
  proxmox-notify prune-nodes --older-than <duration>
USAGE
}

require_no_args() {
  if (($# != 0)); then
    usage >&2
    return 2
  fi
}

main() {
  local cmd="${1:-}"
  if [[ -z "$cmd" ]]; then
    usage >&2
    return 2
  fi
  shift

  case "$cmd" in
    announce)
      require_no_args "$@"
      proxmox_notify_announce
      ;;
    publish)
      proxmox_notify_publish "$@"
      ;;
    get)
      proxmox_notify_get "$@"
      ;;
    list-manifests)
      proxmox_notify_list_manifests "$@"
      ;;
    list-nodes)
      require_no_args "$@"
      proxmox_notify_list_nodes
      ;;
    delete)
      proxmox_notify_delete "$@"
      ;;
    reconcile)
      proxmox_notify_reconcile "$@"
      ;;
    subscribe)
      proxmox_notify_subscribe "$@"
      ;;
    prune-nodes)
      proxmox_notify_prune_nodes "$@"
      ;;
    -h|--help|help)
      usage
      ;;
    *)
      printf 'proxmox-notify: unknown command: %s\n' "$cmd" >&2
      usage >&2
      return 2
      ;;
  esac
}

main "$@"
